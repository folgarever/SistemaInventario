# =============================================================================
# VARIABLES DE ENTORNO PARA SISTEMA DE INVENTARIO (VERCEL Y LOCAL)
# =============================================================================
# Copie este archivo como ".env" y complete los valores reales.
# NUNCA suba el archivo ".env" al repositorio.
# =============================================================================

# Entorno
NODE_ENV=production
PORT=3000

# Base de datos Supabase (Project Settings > API)
# La SERVICE ROLE KEY es privada: solo la usa el backend, nunca Angular.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Seguridad JWT
# En produccion JWT_SECRET es OBLIGATORIO (la API no arranca sin el).
JWT_SECRET=tu_clave_secreta_super_segura_de_produccion_2026
JWT_EXPIRES_IN=7d

# Origenes permitidos para CORS separados por coma (vacio = permitir cualquiera)
# CORS_ORIGINS=https://sistema-inventario.vercel.app,http://localhost:4200
CORS_ORIGINS=

# Registro publico de nuevas cuentas (false = solo las cuentas ya existentes
# pueden iniciar sesion; util para uso personal).
# REGISTRATION_ENABLED=false

# Servicio de correo (Resend) para la recuperacion de contrasena.
RESEND_API_KEY=
EMAIL_FROM=Sistema de Inventario <onboarding@resend.dev>

# URL publica del frontend (se usa para el enlace de restablecimiento).
FRONTEND_URL=http://localhost:4200
